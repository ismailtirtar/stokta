{
  "name": "stokta-android",
  "version": "1.3.4",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "npm run typecheck:app && npm run typecheck:edge",
    "typecheck:app": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "typecheck:edge": "tsc -p tsconfig.edge.json",
    "export:android": "expo export --platform android",
    "build:apk": "eas build --platform android --profile preview",
    "build:play": "eas build --platform android --profile production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.112.3",
    "expo": "~54.0.0",
    "expo-crypto": "~15.0.9",
    "expo-iap": "5.5.0",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-url-polyfill": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "uuid": "11.1.1",
    "postcss": "8.5.28"
  }
}
