{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "22.23.3",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "node": "22.23.3",
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "node": "22.23.3",
      "autoIncrement": true,
      "buildArtifactPaths": [
        "android/app/build/outputs/mapping/**/mapping.txt"
      ],
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "applicationId": "com.ismailtirtar.stokta",
        "track": "internal",
        "releaseStatus": "completed",
        "changesNotSentForReview": false
      }
    }
  }
}
