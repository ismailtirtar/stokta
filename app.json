{
  "expo": {
    "name": "Stokdaş",
    "slug": "dukkan-stok-takip",
    "owner": "homra",
    "version": "1.3.3",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#172820",
    "primaryColor": "#172820",
    "scheme": "stokta",
    "newArchEnabled": true,
    "android": {
      "package": "com.ismailtirtar.stokta",
      "versionCode": 12,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "com.google.android.gms.permission.AD_ID"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#172820"
      }
    },
    "ios": {
      "bundleIdentifier": "com.ismailtirtar.stokta",
      "supportsTablet": false,
      "icon": "./assets/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#172820",
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "./plugins/withAndroidReleaseOptimization.js"
    ],
    "extra": {
      "eas": {
        "projectId": "6d9c0250-c796-4458-9fdb-99e50b690c3b"
      }
    }
  }
}
